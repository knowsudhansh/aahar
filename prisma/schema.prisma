generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FoodType {
  VEG
  NON_VEG
  EGGETARIAN
}

enum ItemType {
  MRP
  READYMADE
  LIVE
}

enum GrnStatus {
  DRAFT
  UNDER_VERIFICATION
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
  POSTED_TO_STOCK
  CANCELLED
}

enum TransferStatus {
  DRAFT
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  CANCELLED
}

enum TransferAcknowledgementStatus {
  ACCEPTED_FULL
  ACCEPTED_PARTIAL
  REJECTED_FULL
}

enum InventoryLocationType {
  STORE
  KITCHEN
  RESTAURANT
  COUNTER
}

enum StockTransactionType {
  GRN_IN
  STORE_TO_RESTAURANT_OUT
  RESTAURANT_RECEIVE_IN
  TRANSFER_REJECTED_RETURN_IN
}

enum StockReferenceType {
  GRN
  TRANSFER
  TRANSFER_ACKNOWLEDGEMENT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  employeeCode String     @unique @map("employee_code")
  name         String
  email        String?    @unique
  mobile       String     @unique
  status       UserStatus @default(ACTIVE)
  hospitalId   String?    @map("hospital_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @updatedAt @map("updated_at")
  updatedBy    String?    @map("updated_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")

  auditLogs AuditLog[]
  hospital  Hospital?  @relation(fields: [hospitalId], references: [id])
  roles     UserRole[]

  @@index([hospitalId])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at")
  updatedBy   String?      @map("updated_by") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at")

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  module      String
  action      String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  roles RolePermission[]

  @@index([module, action])
  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  role Role @relation(fields: [roleId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model Hospital {
  id            String    @id @default(uuid()) @db.Uuid
  hospitalCode  String    @unique @map("hospital_code")
  hospitalName  String    @map("hospital_name")
  address       String?
  city          String?
  state         String?
  gstApplicable Boolean   @default(true) @map("gst_applicable")
  billPrefix    String?   @map("bill_prefix")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")

  auditLogs                AuditLog[]
  counters                 Counter[]
  grns                     Grn[]
  kitchens                 Kitchen[]
  locations                Location[]
  restaurants              Restaurant[]
  restaurantMenus          RestaurantMenu[]
  stockBalances            StockBalance[]
  stockLedgers             StockLedger[]
  stores                   Store[]
  transferAcknowledgements TransferAcknowledgement[]
  transfers                Transfer[]
  users                    User[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("hospitals")
}

model Location {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @map("hospital_id") @db.Uuid
  locationName String    @map("location_name")
  building     String?
  floor        String?
  area         String?
  address      String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  hospital    Hospital     @relation(fields: [hospitalId], references: [id])
  kitchens    Kitchen[]
  restaurants Restaurant[]
  stores      Store[]

  @@index([hospitalId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("locations")
}

model Store {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String    @map("hospital_id") @db.Uuid
  locationId String?   @map("location_id") @db.Uuid
  storeCode  String    @map("store_code")
  storeName  String    @map("store_name")
  storeType  String?   @map("store_type")
  address    String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  hospital    Hospital     @relation(fields: [hospitalId], references: [id])
  location    Location?    @relation(fields: [locationId], references: [id])
  grns        Grn[]
  storeItems  StoreItem[]
  restaurants Restaurant[]

  @@unique([hospitalId, storeCode])
  @@index([hospitalId])
  @@index([locationId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("stores")
}

model Kitchen {
  id          String    @id @default(uuid()) @db.Uuid
  hospitalId  String    @map("hospital_id") @db.Uuid
  locationId  String?   @map("location_id") @db.Uuid
  kitchenCode String    @map("kitchen_code")
  kitchenName String    @map("kitchen_name")
  openingTime String?   @map("opening_time") @db.VarChar(5)
  closingTime String?   @map("closing_time") @db.VarChar(5)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  kitchenItems KitchenItem[]
  restaurants  Restaurant[]

  @@unique([hospitalId, kitchenCode])
  @@index([hospitalId])
  @@index([locationId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("kitchens")
}

model Restaurant {
  id                       String    @id @default(uuid()) @db.Uuid
  hospitalId               String    @map("hospital_id") @db.Uuid
  locationId               String?   @map("location_id") @db.Uuid
  storeId                  String?   @map("store_id") @db.Uuid
  kitchenId                String?   @map("kitchen_id") @db.Uuid
  restaurantCode           String    @map("restaurant_code")
  restaurantName           String    @map("restaurant_name")
  gstNumber                String?   @map("gst_number")
  panNumber                String?   @map("pan_number")
  fssaiNumber              String?   @map("fssai_number")
  address                  String?
  openingTime              String?   @map("opening_time") @db.VarChar(5)
  closingTime              String?   @map("closing_time") @db.VarChar(5)
  normalDiscountApplicable Boolean   @default(false) @map("normal_discount_applicable")
  staffDiscountApplicable  Boolean   @default(false) @map("staff_discount_applicable")
  onlineOrderingEnabled    Boolean   @default(false) @map("online_ordering_enabled")
  inRoomDiningEnabled      Boolean   @default(false) @map("in_room_dining_enabled")
  b2cQrEnabled             Boolean   @default(false) @map("b2c_qr_enabled")
  upiId                    String?   @map("upi_id")
  bankName                 String?   @map("bank_name")
  bankBranch               String?   @map("bank_branch")
  sunBu                    String?   @map("sun_bu")
  sunT1                    String?   @map("sun_t1")
  sunT2                    String?   @map("sun_t2")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  createdBy                String?   @map("created_by") @db.Uuid
  updatedAt                DateTime  @updatedAt @map("updated_at")
  updatedBy                String?   @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at")

  counters        Counter[]
  restaurantMenus RestaurantMenu[]
  hospital        Hospital         @relation(fields: [hospitalId], references: [id])
  kitchen         Kitchen?         @relation(fields: [kitchenId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  store           Store?           @relation(fields: [storeId], references: [id])

  @@unique([hospitalId, restaurantCode])
  @@index([hospitalId])
  @@index([locationId])
  @@index([storeId])
  @@index([kitchenId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("restaurants")
}

model Counter {
  id               String    @id @default(uuid()) @db.Uuid
  hospitalId       String    @map("hospital_id") @db.Uuid
  restaurantId     String    @map("restaurant_id") @db.Uuid
  counterCode      String    @map("counter_code")
  counterName      String    @map("counter_name")
  posDeviceId      String?   @map("pos_device_id")
  paymentDeviceId  String?   @map("payment_device_id")
  pineLabsDeviceId String?   @map("pine_labs_device_id")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, counterCode])
  @@index([hospitalId])
  @@index([restaurantId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("counters")
}

model ItemCategory {
  id             String    @id @default(uuid()) @db.Uuid
  categoryName   String    @unique @map("category_name")
  normalizedName String    @map("normalized_name")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  items Item[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([normalizedName])
  @@map("item_categories")
}

model Item {
  id                     String    @id @default(uuid()) @db.Uuid
  itemCode               String    @unique @map("item_code")
  itemName               String    @map("item_name")
  normalizedName         String    @map("normalized_name")
  categoryId             String    @map("category_id") @db.Uuid
  type                   FoodType
  itemType               ItemType  @map("item_type")
  preparationTimeMinutes Int?      @map("preparation_time_minutes")
  hsnCode                String?   @map("hsn_code")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  createdBy              String?   @map("created_by") @db.Uuid
  updatedAt              DateTime  @updatedAt @map("updated_at")
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")

  category                     ItemCategory                  @relation(fields: [categoryId], references: [id])
  grnBatches                   GrnBatch[]
  grnLines                     GrnLine[]
  kitchenItems                 KitchenItem[]
  restaurantMenus              RestaurantMenu[]
  stockBalances                StockBalance[]
  stockLedgers                 StockLedger[]
  storeItems                   StoreItem[]
  transferAcknowledgementLines TransferAcknowledgementLine[]
  transferLines                TransferLine[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([itemType])
  @@index([normalizedName])
  @@index([type])
  @@map("items")
}

model TimeSlot {
  id                String    @id @default(uuid()) @db.Uuid
  slotName          String    @unique @map("slot_name")
  startTime         String?   @map("start_time") @db.VarChar(5)
  endTime           String?   @map("end_time") @db.VarChar(5)
  isAlwaysAvailable Boolean   @default(false) @map("is_always_available")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([isActive])
  @@index([isAlwaysAvailable])
  @@map("time_slots")
}

model StoreItem {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  itemId    String    @map("item_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  item  Item  @relation(fields: [itemId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([deletedAt])
  @@index([isActive])
  @@index([itemId])
  @@index([storeId])
  @@index([storeId, itemId])
  @@map("store_items")
}

model KitchenItem {
  id        String    @id @default(uuid()) @db.Uuid
  kitchenId String    @map("kitchen_id") @db.Uuid
  itemId    String    @map("item_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  item    Item    @relation(fields: [itemId], references: [id])
  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@index([deletedAt])
  @@index([isActive])
  @@index([itemId])
  @@index([kitchenId])
  @@index([kitchenId, itemId])
  @@map("kitchen_items")
}

model RestaurantMenu {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @map("hospital_id") @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  timeSlotIds  String[]  @default([]) @map("time_slot_ids")
  daysOfWeek   String[]  @default([]) @map("days_of_week")
  isAvailable  Boolean   @default(true) @map("is_available")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([deletedAt])
  @@index([hospitalId])
  @@index([itemId])
  @@index([restaurantId])
  @@index([restaurantId, itemId])
  @@map("restaurant_menus")
}

model Employee {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeCode        String    @unique @map("employee_code")
  employeeName        String    @map("employee_name")
  department          String?
  designation         String?
  mobile              String?
  eligibleForDiscount Boolean   @default(true) @map("eligible_for_discount")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([eligibleForDiscount])
  @@index([isActive])
  @@map("employees")
}

model Grn {
  id            String    @id @default(uuid()) @db.Uuid
  grnNumber     String    @unique @default(dbgenerated("'GRN' || lpad((nextval('grn_number_seq'::regclass))::text, 6, '0'::text)")) @map("grn_number")
  hospitalId    String    @map("hospital_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  receivedDate  DateTime  @map("received_date")
  receivedBy    String    @map("received_by")
  vendorName    String?   @map("vendor_name")
  poNumber      String?   @map("po_number")
  invoiceNumber String?   @map("invoice_number")
  remarks       String?
  status        GrnStatus @default(DRAFT)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")

  hospital Hospital  @relation(fields: [hospitalId], references: [id])
  lines    GrnLine[]
  store    Store     @relation(fields: [storeId], references: [id])

  @@index([deletedAt])
  @@index([hospitalId])
  @@index([receivedDate])
  @@index([status])
  @@index([storeId])
  @@map("grns")
}

model GrnLine {
  id              String    @id @default(uuid()) @db.Uuid
  grnId           String    @map("grn_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  orderedQty      Decimal?  @map("ordered_qty") @db.Decimal(12, 3)
  receivedQty     Decimal   @map("received_qty") @db.Decimal(12, 3)
  acceptedQty     Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty     Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason String?   @map("rejection_reason")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  batches GrnBatch[]
  grn     Grn        @relation(fields: [grnId], references: [id])
  item    Item       @relation(fields: [itemId], references: [id])

  @@index([deletedAt])
  @@index([grnId])
  @@index([itemId])
  @@map("grn_lines")
}

model GrnBatch {
  id                String    @id @default(uuid()) @db.Uuid
  grnLineId         String    @map("grn_line_id") @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime  @map("expiry_date") @db.Date
  receivedQty       Decimal   @map("received_qty") @db.Decimal(12, 3)
  acceptedQty       Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty       Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  grnLine GrnLine @relation(fields: [grnLineId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([grnLineId])
  @@index([itemId])
  @@map("grn_batches")
}

model Transfer {
  id              String                @id @default(uuid()) @db.Uuid
  transferNumber  String                @unique @default(dbgenerated("'TRF' || lpad((nextval('transfer_number_seq'::regclass))::text, 4, '0'::text)")) @map("transfer_number")
  hospitalId      String                @map("hospital_id") @db.Uuid
  sourceType      InventoryLocationType @map("source_type")
  sourceId        String                @map("source_id") @db.Uuid
  destinationType InventoryLocationType @map("destination_type")
  destinationId   String                @map("destination_id") @db.Uuid
  transferDate    DateTime              @map("transfer_date")
  businessDate    DateTime              @map("business_date") @db.Date
  status          TransferStatus        @default(DRAFT)
  remarks         String?
  createdAt       DateTime              @default(now()) @map("created_at")
  createdBy       String?               @map("created_by") @db.Uuid
  updatedAt       DateTime              @updatedAt @map("updated_at")
  updatedBy       String?               @map("updated_by") @db.Uuid
  deletedAt       DateTime?             @map("deleted_at")

  acknowledgements TransferAcknowledgement[]
  hospital         Hospital                  @relation(fields: [hospitalId], references: [id])
  lines            TransferLine[]

  @@index([businessDate])
  @@index([deletedAt])
  @@index([destinationType, destinationId])
  @@index([hospitalId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([transferDate])
  @@map("transfers")
}

model TransferLine {
  id              String    @id @default(uuid()) @db.Uuid
  transferId      String    @map("transfer_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  batchNumber     String    @map("batch_number")
  expiryDate      DateTime  @map("expiry_date") @db.Date
  sentQty         Decimal   @map("sent_qty") @db.Decimal(12, 3)
  acceptedQty     Decimal   @default(0) @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty     Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason String?   @map("rejection_reason")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  acknowledgementLines TransferAcknowledgementLine[]
  item                 Item                          @relation(fields: [itemId], references: [id])
  transfer             Transfer                      @relation(fields: [transferId], references: [id])

  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([itemId])
  @@index([transferId])
  @@map("transfer_lines")
}

model TransferAcknowledgement {
  id                  String                        @id @default(uuid()) @db.Uuid
  transferId          String                        @unique @map("transfer_id") @db.Uuid
  hospitalId          String                        @map("hospital_id") @db.Uuid
  acknowledgementDate DateTime                      @default(now()) @map("acknowledgement_date")
  status              TransferAcknowledgementStatus
  remarks             String?
  createdAt           DateTime                      @default(now()) @map("created_at")
  createdBy           String?                       @map("created_by") @db.Uuid
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  updatedBy           String?                       @map("updated_by") @db.Uuid
  deletedAt           DateTime?                     @map("deleted_at")

  hospital Hospital                      @relation(fields: [hospitalId], references: [id])
  lines    TransferAcknowledgementLine[]
  transfer Transfer                      @relation(fields: [transferId], references: [id])

  @@index([acknowledgementDate])
  @@index([deletedAt])
  @@index([hospitalId])
  @@index([status])
  @@map("transfer_acknowledgements")
}

model TransferAcknowledgementLine {
  id                String    @id @default(uuid()) @db.Uuid
  acknowledgementId String    @map("acknowledgement_id") @db.Uuid
  transferLineId    String    @map("transfer_line_id") @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  batchNumber       String    @map("batch_number")
  expiryDate        DateTime  @map("expiry_date") @db.Date
  sentQty           Decimal   @map("sent_qty") @db.Decimal(12, 3)
  acceptedQty       Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty       Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason   String?   @map("rejection_reason")
  remarks           String?
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  acknowledgement TransferAcknowledgement @relation(fields: [acknowledgementId], references: [id])
  item            Item                    @relation(fields: [itemId], references: [id])
  transferLine    TransferLine            @relation(fields: [transferLineId], references: [id])

  @@index([acknowledgementId])
  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([itemId])
  @@index([transferLineId])
  @@map("transfer_acknowledgement_lines")
}

model StockLedger {
  id                  String                @id @default(uuid()) @db.Uuid
  hospitalId          String                @map("hospital_id") @db.Uuid
  locationType        InventoryLocationType @map("location_type")
  locationId          String                @map("location_id") @db.Uuid
  itemId              String                @map("item_id") @db.Uuid
  itemType            ItemType              @map("item_type")
  batchNumber         String?               @map("batch_number")
  expiryDate          DateTime?             @map("expiry_date") @db.Date
  transactionType     StockTransactionType  @map("transaction_type")
  referenceType       StockReferenceType?   @map("reference_type")
  referenceId         String?               @map("reference_id") @db.Uuid
  qtyIn               Decimal               @default(0) @map("qty_in") @db.Decimal(12, 3)
  qtyOut              Decimal               @default(0) @map("qty_out") @db.Decimal(12, 3)
  balanceAfter        Decimal               @default(0) @map("balance_after") @db.Decimal(12, 3)
  businessDate        DateTime              @map("business_date") @db.Date
  transactionDateTime DateTime              @map("transaction_datetime")
  remarks             String?
  createdAt           DateTime              @default(now()) @map("created_at")
  createdBy           String?               @map("created_by") @db.Uuid
  updatedAt           DateTime              @updatedAt @map("updated_at")
  updatedBy           String?               @map("updated_by") @db.Uuid
  deletedAt           DateTime?             @map("deleted_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([batchNumber])
  @@index([businessDate])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([hospitalId])
  @@index([itemId])
  @@index([locationType, locationId])
  @@index([referenceType, referenceId])
  @@index([transactionDateTime])
  @@index([transactionType])
  @@map("stock_ledgers")
}

model StockBalance {
  id            String                @id @default(uuid()) @db.Uuid
  hospitalId    String                @map("hospital_id") @db.Uuid
  locationType  InventoryLocationType @map("location_type")
  locationId    String                @map("location_id") @db.Uuid
  itemId        String                @map("item_id") @db.Uuid
  itemType      ItemType              @map("item_type")
  batchNumber   String?               @map("batch_number")
  expiryDate    DateTime?             @map("expiry_date") @db.Date
  availableQty  Decimal               @default(0) @map("available_qty") @db.Decimal(12, 3)
  reservedQty   Decimal               @default(0) @map("reserved_qty") @db.Decimal(12, 3)
  lastUpdatedOn DateTime              @default(now()) @map("last_updated_on")
  createdAt     DateTime              @default(now()) @map("created_at")
  createdBy     String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at")
  updatedBy     String?               @map("updated_by") @db.Uuid
  deletedAt     DateTime?             @map("deleted_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([hospitalId, locationType, locationId, itemId, batchNumber, expiryDate], map: "stock_balances_unique_batch_key")
  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([hospitalId])
  @@index([itemId])
  @@index([locationType, locationId])
  @@map("stock_balances")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String?   @map("hospital_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  entityName String    @map("entity_name")
  entityId   String    @map("entity_id") @db.Uuid
  action     String
  oldValue   Json?     @map("old_value")
  newValue   Json?     @map("new_value")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([entityName, entityId])
  @@index([hospitalId])
  @@index([userId])
  @@index([deletedAt])
  @@map("audit_logs")
}
